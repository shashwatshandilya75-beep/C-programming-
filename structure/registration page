#include <stdio.h>
#include <string.h>

#define MAX_LIMIT 30


struct User {
    char username[MAX_LIMIT];
    char password[MAX_LIMIT];
};

void registerUser() {
    FILE *file;
    struct User newUser;

  
    file = fopen("database.txt", "a");
    if (file == NULL) {
        printf("\n[Error] Could not open database file.\n");
        return;
    }

    printf("\n--- CREATE NEW ACCOUNT ---\n");
    
    // Get Username
    printf("Enter username (no spaces): ");
    scanf("%29s", newUser.username);

    // Get Password
    printf("Enter password (no spaces): ");
    scanf("%29s", newUser.password);

    
    fprintf(file, "%s %s\n", newUser.username, newUser.password);
    fclose(file);

    printf("\n[Success] Registration completed successfully!\n");
}

int main() {
    int choice;
    int keepRunning = 1;

    while(keepRunning) {
        printf("\n===== WELCOME SYSTEM =====\n");
        printf("1. Register\n");
        printf("2. Exit\n");
        printf("Enter your choice: ");
        
        if (scanf("%d", &choice) != 1) {
            printf("\nInvalid input. Exiting...\n");
            keepRunning = 0;
            break;
        }

        switch(choice) {
            case 1:
                registerUser();
                break;
            case 2:
                printf("\nThank you for using the system. Goodbye!\n");
                keepRunning = 0; // Breaks the loop cleanly
                break;
            default:
                printf("\nInvalid choice! Please select 1 or 2.\n");
        }
    }

    return 0;
}
