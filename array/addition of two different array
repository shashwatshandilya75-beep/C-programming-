#include <stdio.h>

int main()
{
    int       A[3][3] = {1,2,3,4,5,6,7,8,9,};
    char      B[3][3] = {'a','b','c','d','e','f','g','h','i'};


    printf("\n");
    for(int i = 0; i<3;i++ ){
        for(int j = 0 ; j <3 ; j++){
            printf("%d ", A[i][j]);
            
        }
        printf("\n");
    }
    printf("\n");
    for(int i = 0; i<3;i++ ){
        for(int j = 0 ; j <3 ; j++){
            printf("%c ", B[i][j]);
            
        }
        printf("\n");
    }
     printf("\n");
    for(int i = 0; i<3;i++ ){
        for(int j = 0 ; j <3 ; j++){
            
            printf("%d+%c \t", A[i][j],B[i][j]);
        } 
        printf("\n");
    }
   
    return 0;
    
}
